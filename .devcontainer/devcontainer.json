{
  "name": "Maestranze Italia",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000, 8025, 4000],
  "portsAttributes": {
    "3000": { "label": "Maestranze Italia", "onAutoForward": "openBrowser" },
    "8025": { "label": "Posta e SMS di prova", "onAutoForward": "notify" },
    "4000": { "label": "API (per l'app sul telefono)", "onAutoForward": "silent" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "codespaces": { "openFiles": ["docs/AVVIO-CODESPACES.md"] }
  }
}
