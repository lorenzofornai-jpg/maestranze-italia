NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://maestranze:maestranze@localhost:5432/maestranze
# Indirizzo pubblico del sito web (link nelle email, controllo Origin)
WEB_ORIGIN=http://localhost:3000
# 32 byte in base64: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Maestranze Italia <concierge@maestranze.it>"
# SMS: console (solo sviluppo, i codici finiscono nel log) | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero mittente E.164, oppure un Messaging Service con mittente alfanumerico («Maestranze»)
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Notifiche push all'app: console | expo
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=
# Cartella delle immagini caricate
MEDIA_DIR=./uploads
# Ricerca in linguaggio naturale con l'LLM: auto (attiva se c'è ANTHROPIC_API_KEY) | on | off
AI_SEARCH=auto
ANTHROPIC_API_KEY=
